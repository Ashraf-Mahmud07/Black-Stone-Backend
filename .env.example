# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/black-stone
appName=Black Stone

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
BCRYPT_SALT_ROUND=12
# use a long random string in production
JWT_SECRET=
# access token lifetime in seconds (default 1 day)
JWT_EXPIRATION=86400
# keep this different from JWT_SECRET in production
JWT_REFRESH_SECRET=
# refresh token lifetime in seconds (default 30 days)
JWT_REFRESH_EXPIRATION=2592000

# seeded admin account
SUPER_ADMIN_EMAIL=admin@blackstone.test
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Client / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Media storage - every product image, product video and payment screenshot
# is uploaded to Cloudinary. All three credentials are required.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# every asset is created under this base folder
CLOUDINARY_FOLDER=black-stone

MAX_UPLOAD_SIZE_MB=5
MAX_VIDEO_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# Manual payment configuration (bKash / Nagad) - never commit real numbers
# ---------------------------------------------------------------------------
# the store is cash on delivery only. Set to true to re-open the bKash/Nagad
# submission flow - no code change or migration is needed.
ONLINE_PAYMENTS_ENABLED=false

# only used to render payment instructions while ONLINE_PAYMENTS_ENABLED=true
BKASH_MERCHANT_NUMBER=
BKASH_ACCOUNT_TYPE=personal
NAGAD_MERCHANT_NUMBER=
NAGAD_ACCOUNT_TYPE=personal

# ---------------------------------------------------------------------------
# Commerce defaults (used until delivery settings are saved from the admin panel)
# ---------------------------------------------------------------------------
DEFAULT_DELIVERY_CHARGE=80
# the storefront offers exactly two areas; both rates are editable by an admin at runtime
# through PATCH /api/delivery/settings - these are only the first-run defaults
DELIVERY_CHARGE_INSIDE_DHAKA=80
DELIVERY_CHARGE_OUTSIDE_DHAKA=150
FREE_DELIVERY_ENABLED=false
FREE_DELIVERY_THRESHOLD=3000
LOW_STOCK_THRESHOLD=5

# ---------------------------------------------------------------------------
# Email (order / system notifications)
# ---------------------------------------------------------------------------
SENDER_EMAIL=
SENDER_EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Development seed data - MUST stay false in production
# ---------------------------------------------------------------------------
SEED_DEV_DATA=false
SEED_CUSTOMER_EMAIL=customer@blackstone.test
SEED_CUSTOMER_PASSWORD=

# ---------------------------------------------------------------------------
# API documentation (Swagger UI + OpenAPI JSON)
# ---------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
# base url shown in the Swagger "Servers" dropdown
API_BASE_URL=http://localhost:5000
API_STAGING_URL=
API_PRODUCTION_URL=
# set BOTH to protect /api-docs and /api-docs.json with HTTP basic auth (recommended in production)
SWAGGER_USER=
SWAGGER_PASSWORD=
