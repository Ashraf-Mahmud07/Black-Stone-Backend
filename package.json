{
	"name": "black-stone-backend",
	"version": "1.0.0",
	"description": "Backend API for the Black Stone women fashion e-commerce platform (Hijab, Orna, Three-Piece).",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"lint": "eslint src --ignore-path .eslintignore --ext .ts",
		"lint:fix": "npx eslint src --fix",
		"prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
		"prettier:fix": "npx prettier --write src",
		"start:dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
		"start:prod": "node ./dist/server.js",
		"test": "vitest run",
		"type-check": "tsc --noEmit",
		"seed": "ts-node ./src/seed.ts",
		"test:watch": "vitest",
		"swagger:json": "ts-node ./src/scripts/exportOpenApi.ts",
		"type-check:all": "tsc -p tsconfig.api.json"
	},
	"keywords": [],
	"author": "Ashraful Islam",
	"license": "ISC",
	"dependencies": {
		"bcryptjs": "^3.0.2",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.5.0",
		"express": "^5.1.0",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.13.2",
		"multer": "^2.3.0",
		"nodemailer": "^6.10.0",
		"swagger-ui-express": "^5.0.1",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.1",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/multer": "^2.2.0",
		"@types/nodemailer": "^6.4.17",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^8.29.1",
		"@typescript-eslint/parser": "^8.29.1",
		"eslint": "^9.24.0",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-prettier": "^5.2.6",
		"prettier": "^3.5.3",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.8.3",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": "22.x"
	}
}
